{
  "buildCommand": "pnpm --filter @production-platform/database db:generate && pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/apps/api/src/server.ts" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}