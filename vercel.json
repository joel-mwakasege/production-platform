{
  "installCommand": "pnpm install && pnpm --filter @production-platform/database db:generate",
  "buildCommand": "pnpm --filter ./apps/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/api/index" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}