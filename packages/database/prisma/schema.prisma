generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectType {
  FILM
  TELEVISION
  COMMERCIAL
  DOCUMENTARY
  MUSIC_VIDEO
  CORPORATE_VIDEO
  EVENT
  PHOTOSHOOT
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

// --- NEW: Screenplay Element Types ---
enum ScreenplayElementType {
  SCENE_HEADING
  ACTION
  CHARACTER
  DIALOGUE
  PARENTHETICAL
  TRANSITION
  SHOT
}

model Profile {
  id          String   @id @db.Uuid
  displayName String?
  avatarUrl   String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrganizationMember[]
  projects    ProjectMember[]

  @@map("profiles")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  profileId      String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileId])
  @@index([profileId])
  @@map("organization_members")
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  projectType    ProjectType   @default(OTHER)
  client         String?
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  tasks        Task[]
  screenplay   Screenplay?
  elements     ProductionElement[]
  shootDays    ShootDay[]
  contacts     Contact[]
  locations    Location[]
  callSheets   CallSheet[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  profileId String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([profileId])
  @@map("project_members")
}

model Task {
  id        String    @id @default(uuid())
  projectId String
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tasks")
}

model Screenplay {
  id        String   @id @default(uuid())
  projectId String   @unique
  title     String   @default("Screenplay")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  Scene[]

  @@map("screenplays")
}

model Scene {
  id           String   @id @default(uuid())
  screenplayId String
  sceneNumber  Int
  heading      String
  body         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  screenplay     Screenplay          @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  elements       SceneElement[]      
  scriptElements ScreenplayElement[] // NEW: Structured script blocks
  schedule       SceneSchedule[]

  @@unique([screenplayId, sceneNumber])
  @@index([screenplayId])
  @@map("scenes")
}

// --- NEW: Structured Screenplay Elements ---
model ScreenplayElement {
  id        String                @id @default(uuid())
  type      ScreenplayElementType
  content   String                @db.Text
  position  Int                   
  
  sceneId   String
  scene     Scene                 @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([sceneId])
  @@map("screenplay_elements")
}

enum ProductionElementCategory {
  CAST
  CREW
  LOCATION
  PROP
  COSTUME
  VEHICLE
  SET_DRESSING
  OTHER
}

model ProductionElement {
  id        String                    @id @default(uuid())
  projectId String
  name      String
  category  ProductionElementCategory
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  SceneElement[]

  @@unique([projectId, name, category])
  @@index([projectId])
  @@map("production_elements")
}

model SceneElement {
  sceneId   String
  elementId String
  createdAt DateTime @default(now())

  scene   Scene             @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  element ProductionElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@id([sceneId, elementId])
  @@index([elementId])
  @@map("scene_elements")
}

model ShootDay {
  id        String   @id @default(uuid())
  projectId String
  dayNumber Int
  date      DateTime
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    SceneSchedule[]
  callSheet CallSheet?

  @@unique([projectId, dayNumber])
  @@index([projectId])
  @@map("shoot_days")
}

model SceneSchedule {
  sceneId    String
  shootDayId String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  scene    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@id([sceneId, shootDayId])
  @@index([shootDayId])
  @@map("scene_schedule")
}

enum ContactCategory {
  CAST
  CREW
  CLIENT
  VENDOR
  LOCATION
  PRODUCTION
  OTHER
}

model Contact {
  id         String          @id @default(uuid())
  projectId  String
  name       String
  role       String?
  department String?
  company    String?
  email      String?
  phone      String?
  address    String?
  notes      String?
  category   ContactCategory @default(CREW)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("contacts")
}

model Location {
  id              String   @id @default(uuid())
  projectId       String
  name            String
  address         String?
  description     String?
  parking         String?
  basecamp        String?
  nearestHospital String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("locations")
}

model CallSheet {
  id              String   @id @default(uuid())
  projectId       String
  shootDayId      String   @unique
  title           String?
  generalCrewCall String?
  breakfastTime   String?
  firstShotTime   String?
  lunchTime       String?
  estimatedWrap   String?
  weatherNotes    String?
  locationName    String?
  locationAddress String?
  parkingNotes    String?
  basecampNotes   String?
  nearestHospital String?
  generalNotes    String?
  departmentNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shootDay  ShootDay   @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  castCalls CastCall[]

  @@index([projectId])
  @@map("call_sheets")
}

model CastCall {
  id            String   @id @default(uuid())
  callSheetId   String
  castNumber    String?
  characterName String
  actorName     String
  status        String?
  pickupTime    String?
  hmuCall       String?
  onSetCall     String?
  notes         String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  callSheet CallSheet @relation(fields: [callSheetId], references: [id], onDelete: Cascade)

  @@index([callSheetId])
  @@map("cast_calls")
}