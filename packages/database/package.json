{
  "name": "@production-platform/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc src/index.ts --outDir dist --declaration --target ES2022 --module CommonJS --moduleResolution node",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "typescript": "^5.9.2"
  }
}